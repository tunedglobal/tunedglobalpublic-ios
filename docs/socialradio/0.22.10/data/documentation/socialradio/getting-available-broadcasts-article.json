{"primaryContentSections":[{"kind":"content","content":[{"anchor":"Essentials","text":"Essentials","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"When you want to fetch a list of currently available live broadcasts as paged request, you use "},{"identifier":"doc:\/\/org.cocoapods.SocialRadio\/documentation\/SocialRadio\/SocialRadio\/getLiveBroadcasts(limit:start:completion:)","type":"reference","isActive":true},{"type":"text","text":" as shown below:"}]},{"syntax":"swift","type":"codeListing","code":["public class MyApplication {","    \/\/ ...","    func getBroadcasts() -> Void {","        let limit: Int = 10             \/\/ Get a total of 10 broadcasts","        let start: Int = 0              \/\/ Get the first broadcasts","        SocialRadio.instance.getLiveBroadcasts(limit: limit, start: start) { error, liveBroadcasts in","            \/\/ Present the broadcasts on your UI","            let myLiveBroadcasts = myLiveBroadcasts","            myLiveBroadcasts.add(liveBroadcasts)","            if(liveBroadcasts.size < limit) {","                \/\/ There are more broadcasts available!","                getNextLiveBroadcastsPage()","            }","        }","    }","    \/\/ ...","}"]}]}],"hierarchy":{"paths":[["doc:\/\/org.cocoapods.SocialRadio\/documentation\/SocialRadio"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"roleHeading":"Article","modules":[{"name":"SocialRadio"}],"title":"Getting available broadcasts","role":"article"},"variants":[{"paths":["\/documentation\/socialradio\/getting-available-broadcasts-article"],"traits":[{"interfaceLanguage":"swift"}]},{"traits":[{"interfaceLanguage":"occ"}],"paths":["\/documentation\/socialradio\/getting-available-broadcasts-article"]}],"kind":"article","abstract":[{"text":"How to learn which broadcasts are currently live.","type":"text"}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/org.cocoapods.SocialRadio\/documentation\/SocialR